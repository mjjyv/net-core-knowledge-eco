{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=theEcosystem.db"
  },
  "DatabaseProvider": "Sqlite",
  "JwtSettings": {
    "SecretKey": "TheEcosystem_Local_Dev_Super_Secret_Key_At_Least_64_Bytes_HS256_2026!",
    "Issuer": "TheEcosystem.AuthServer",
    "Audience": "TheEcosystem.WebClient",
    "ExpiryInMinutes": 60,
    "RefreshTokenExpiryInDays": 7
  },
  "FileStorage": {
    "MaxFileSizeBytes": 5242880,
    "MaxRequestTotalBytes": 15728640,
    "MaxFilesPerRequest": 10,
    "UploadFolder": "wwwroot/uploads",
    "VerifyMagicBytes": true
  },
  "EcosystemFeatures": {
    "ApplicationTitle": "The Ecosystem Web API (Development)",
    "EnvironmentBanner": "Development Mode - Swagger & Auto-Seed Active",
    "EnableSwagger": true,
    "EnableDetailedErrors": true,
    "EnableAutoMigration": true,
    "ConfigVersion": "1.0.0-dev",
    "DefaultPageSize": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  }
}
