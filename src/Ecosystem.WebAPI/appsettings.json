{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=theEcosystem.db"
  },
  "DatabaseProvider": "Sqlite",
  "JwtSettings": {
    "SecretKey": "TheEcosystem_Placeholder_Change_In_Prod_Min_32_Bytes_Secret_Key_2026!",
    "Issuer": "TheEcosystem.AuthServer",
    "Audience": "TheEcosystem.WebClient",
    "ExpiryInMinutes": 60,
    "RefreshTokenExpiryInDays": 7
  },
  "FileStorage": {
    "MaxFileSizeBytes": 5242880,
    "MaxRequestTotalBytes": 15728640,
    "MaxFilesPerRequest": 5,
    "UploadFolder": "wwwroot/uploads",
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp", ".gif", ".pdf", ".md" ],
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "image/gif",
      "application/pdf",
      "text/markdown",
      "text/plain"
    ],
    "VerifyMagicBytes": true
  },
  "EcosystemFeatures": {
    "ApplicationTitle": "The Ecosystem Knowledge & Classroom API",
    "EnvironmentBanner": "Base Standard Configuration",
    "EnableSwagger": false,
    "EnableDetailedErrors": false,
    "EnableAutoMigration": false,
    "ConfigVersion": "1.0.0-base",
    "DefaultPageSize": 20
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*"
}
