{
  "FileStorage": {
    "MaxFileSizeBytes": 5242880,
    "MaxRequestTotalBytes": 15728640,
    "MaxFilesPerRequest": 5,
    "UploadFolder": "wwwroot/uploads",
    "VerifyMagicBytes": true
  },
  "EcosystemFeatures": {
    "ApplicationTitle": "The Ecosystem Web API",
    "EnvironmentBanner": "Production Hardened Mode",
    "EnableSwagger": false,
    "EnableDetailedErrors": false,
    "EnableAutoMigration": false,
    "ConfigVersion": "1.0.0-prod",
    "DefaultPageSize": 20
  },
  "Cors": {
    "AllowedOrigins": [
      "https://ecosystem.vn",
      "https://app.ecosystem.vn"
    ],
    "AllowCredentials": true,
    "ExposedHeaders": [
      "X-Pagination",
      "X-Request-Id",
      "X-Response-Time-Ms"
    ]
  },
  "Observability": {
    "SlowRequestThresholdMs": 500,
    "IncludeExceptionDetailsInResponse": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff "
      }
    }
  }
}
